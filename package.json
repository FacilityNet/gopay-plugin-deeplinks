{
  "name": "@facilitynet/gopay-plugin-deeplinks",
  "version": "2.3.7",
  "description": "Cordova plugin to add in your application support for Universal Links (iOS 9) and Deep Links (Android). Basically, open application through the link in the browser. Also supports custom URL schemes.",
  "cordova": {
    "id": "gopay-plugin-deeplinks",
    "platforms": [
      "ios",
      "android"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/FacilityNet/gopay-plugin-deeplinks.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "keywords": [
    "cordova",
    "links",
    "universal",
    "deep links",
    "universal links",
    "ecosystem:cordova",
    "cordova-ios",
    "cordova-android",
    "ios",
    "android",
    "gopay"
  ],
  "engines": {
    "cordova-ios": ">=3.8",
    "cordova-android": ">=4"
  },
  "dependencies": {
    "node-version-compare": "^1.0.3",
    "plist": "^3.1.0",
    "xml2js": "^0.6.2"
  },
  "author": "Nikolay Demyankov for Nordnet Bank AB",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/FacilityNet/gopay-plugin-deeplinks/issues"
  },
  "homepage": "https://github.com/FacilityNet/gopay-plugin-deeplinks#readme",
  "devDependencies": {
    "standard-version": "^7.0.0"
  },
  "scripts": {
    "release": "standard-version"
  }
}
